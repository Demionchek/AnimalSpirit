--- !u!114 &3504477065500202712
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6128347306101000731}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7b9f966cbd6145439b4e401d06d75d46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  introLines:
  - Oh mighty Spirit of the Forest, hear me!
  - Come and save our home!
  - 'Note: use F to interact'
  interactionLine1:
  - they didn't see me, i'm too small!
  - you could squeze thru this pipe, if you were like me...
  interactionLine2:
  - The only way to get across is from above...
  - 'Note: Press Q to switch form'
  interactionLine3:
  - Thank you for stopping him, but more of them will come
  - There is a facility that you should destroy before it's too late!
